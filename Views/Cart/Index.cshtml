@model IReadOnlyList<(Product Product, int Quantity)>
@inject ICartService Cart
@{
    ViewData["Title"] = "سلة التسوق";
}
<div class="container section-block" style="max-width:48rem;">
    @if (Model.Count == 0)
    {
        <div class="text-center" style="padding:4rem 0;">
            <p style="font-size:3rem;opacity:0.2;margin:0;">🛍</p>
            <h1 class="page-title" style="margin:1.25rem 0 0.75rem;">سلتك فارغة</h1>
            <p class="text-muted mb-8" style="font-weight:300;font-size:1.05rem;">تصفّح المنتجات واختر ما يناسبك.</p>
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">متابعة التسوق</a>
        </div>
    }
    else
    {
        <h1 class="page-title">سلة التسوق</h1>

        @foreach (var line in Model)
        {
            <div class="flex-between" style="gap:1rem;padding-bottom:1.5rem;margin-bottom:1.5rem;border-bottom:1px solid var(--border);align-items:flex-start;">
                <a asp-controller="Products" asp-action="Detail" asp-route-id="@line.Product.Id" class="card-img cart-line-thumb">
                    <img src="@line.Product.ImageUrl" alt="" />
                </a>
                <div style="flex:1;">
                    <div class="flex-between" style="align-items:flex-start;">
                        <div>
                            <h3 style="font-size:1.15rem;margin:0;font-family:'El Messiri',Georgia,serif;font-weight:500;">@line.Product.Name</h3>
                            <p class="text-muted" style="font-size:0.7rem;margin:0.25rem 0 0;">@CategoryLabels.Arabic(line.Product.Category)</p>
                        </div>
                        <form asp-controller="Cart" asp-action="Remove" method="post" style="margin:0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <button type="submit" class="text-muted" style="background:none;border:none;cursor:pointer;padding:0.25rem;">✕</button>
                        </form>
                    </div>
                    <div class="flex-between" style="margin-top:1rem;">
                        <form asp-controller="Cart" asp-action="Update" method="post" class="flex" style="gap:0;align-items:center;border:1px solid var(--border);border-radius:2px;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@line.Product.Id" />
                            <button type="submit" name="quantity" value="@(line.Quantity - 1)" class="btn" style="padding:0.5rem;background:transparent;color:var(--fg);min-width:auto;">−</button>
                            <span style="min-width:2rem;text-align:center;font-size:0.875rem;">@line.Quantity</span>
                            <button type="submit" name="quantity" value="@(line.Quantity + 1)" class="btn" style="padding:0.5rem;background:transparent;color:var(--fg);min-width:auto;">+</button>
                        </form>
                        <span>@((line.Product.Price * line.Quantity).ToString("N0")) ج.م</span>
                    </div>
                </div>
            </div>
        }

        <div style="margin-top:2rem;padding-top:1.5rem;border-top:1px solid var(--border);">
            <div class="flex-between mb-8">
                <span class="text-muted" style="font-size:0.8rem;letter-spacing:0.08em;text-transform:uppercase;">الإجمالي</span>
                <span class="cart-total-amount">@Cart.Total.ToString("N0") ج.م</span>
            </div>
            <a asp-controller="Checkout" asp-action="Index" class="btn btn-primary btn-block">إتمام الطلب</a>
        </div>
    }
</div>
