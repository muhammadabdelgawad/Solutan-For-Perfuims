@model HomeIndexViewModel
@{
    ViewData["Title"] = "الرئيسية";
}
<section class="hero">
    <img class="bg" src="~/images/placeholder.svg" alt="" />
    <div class="overlay"></div>
    <div class="container hero-inner">
        <h1>فنّ الجمال الراقي</h1>
        <p class="hero-lead">
            اكتشف مجموعتنا المختارة من العطور الفاخرة ومستحضرات التجميل، من أجل من يقدّر التميز.
        </p>
        <a asp-controller="Products" asp-action="Index" class="btn btn-ghost">استكشف المجموعة</a>
    </div>
</section>

<section class="container section-block">
    <div class="flex-between" style="flex-wrap:wrap;gap:1.5rem;margin-bottom:3rem;align-items:flex-end;">
        <div>
            <p class="section-eyebrow">اختيار مميز</p>
            <h2 class="section-title">منتجات مميزة</h2>
        </div>
        <a asp-controller="Products" asp-action="Index" class="section-link">عرض الكل ←</a>
    </div>
    <div class="product-grid product-grid--home">
        @foreach (var p in Model.Featured)
        {
            <partial name="_ProductCard" model="p" />
        }
    </div>
</section>

<section class="container" style="padding-bottom:clamp(3.5rem,10vw,6rem);">
    <div class="cat-grid">
        @foreach (var kv in Model.CategoryHeroImages)
        {
            <a asp-controller="Products" asp-action="Index" asp-route-category="@kv.Key" class="cat-tile">
                <img src="@kv.Value" alt="@CategoryLabels.Arabic(kv.Key)" />
                <div class="shade"></div>
                <h3>@CategoryLabels.Arabic(kv.Key)</h3>
            </a>
        }
    </div>
</section>
