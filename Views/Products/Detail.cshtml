@model ProductDetailViewModel
@{
    ViewData["Title"] = Model.Product.Name;
    var returnUrl = Url.Action("Index", "Products") ?? "/Products";
}
<div class="container detail-page">
    <a href="@returnUrl" class="detail-back">→ العودة للمتجر</a>

    <div class="detail-two-col">
        <div class="detail-gallery">
            <img src="@Model.Product.ImageUrl" alt="@Model.Product.Name" />
        </div>
        <div class="detail-info" style="display:flex;flex-direction:column;justify-content:center;padding-top:0.5rem;">
            <p class="section-eyebrow" style="margin-bottom:0.65rem;">@CategoryLabels.Arabic(Model.Product.Category)</p>
            <h1>@Model.Product.Name</h1>
            <p class="detail-price">@Model.Product.Price.ToString("N0") ج.م</p>
            <p class="detail-desc">@Model.Product.Description</p>

            <form asp-controller="Cart" asp-action="Add" method="post" style="margin-top:2.25rem;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.Product.Id" />
                <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                <button type="submit" class="btn btn-primary">أضف إلى السلة</button>
            </form>

            <div style="margin-top:3.5rem;padding-top:2rem;border-top:1px solid var(--border);">
                <div style="display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;font-size:0.88rem;">
                    <div>
                        <p class="text-muted" style="margin:0 0 0.35rem;font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;">الشحن</p>
                        <p style="margin:0;color:var(--fg-soft);font-weight:300;">توصيل عادي مجاني</p>
                    </div>
                    <div>
                        <p class="text-muted" style="margin:0 0 0.35rem;font-size:0.65rem;letter-spacing:0.12em;text-transform:uppercase;">الإرجاع</p>
                        <p style="margin:0;color:var(--fg-soft);font-weight:300;">إرجاع خلال 30 يوماً</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.Related.Count > 0)
    {
        <div style="margin-top:clamp(4rem,10vw,6rem);">
            <p class="section-eyebrow">قد يعجبك أيضاً</p>
            <h2 class="section-title" style="margin-bottom:2.5rem;">إضافات مقترحة</h2>
            <div class="product-grid product-grid--large">
                @foreach (var p in Model.Related)
                {
                    <partial name="_ProductCard" model="p" />
                }
            </div>
        </div>
    }
</div>
