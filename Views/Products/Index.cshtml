@model ProductsIndexViewModel
@{
    ViewData["Title"] = "المتجر";
    string TitleText()
    {
        if (Model.ActiveCategory is null) return "جميع المنتجات";
        return CategoryLabels.Arabic(Model.ActiveCategory.Value);
    }
}
<div class="container products-page section-block">
    <h1 class="page-title">@TitleText()</h1>

    <div style="display:flex;flex-direction:column;gap:1.25rem;margin-bottom:3.5rem;">
        <form method="get" asp-controller="Products" asp-action="Index" class="flex" style="gap:1rem;flex-wrap:wrap;align-items:center;">
            @if (Model.ActiveCategory is { } ac)
            {
                <input type="hidden" name="category" value="@ac" />
            }
            <div class="search-wrap">
                <span class="icon">🔍</span>
                <input class="field-input" type="search" name="search" value="@Model.Search" placeholder="ابحث عن منتج…" />
            </div>
            <button type="submit" class="btn btn-ghost" style="padding:0.65rem 1.25rem;">بحث</button>
        </form>

        <div class="flex" style="gap:0.6rem;flex-wrap:wrap;">
            <a asp-controller="Products" asp-action="Index" asp-route-search="@Model.Search" class="filter-pill @(Model.ActiveCategory == null ? "active" : "")">الكل</a>
            <a asp-controller="Products" asp-action="Index" asp-route-category="Perfumes" asp-route-search="@Model.Search" class="filter-pill @(Model.ActiveCategory == Category.Perfumes ? "active" : "")">عطور</a>
            <a asp-controller="Products" asp-action="Index" asp-route-category="Makeup" asp-route-search="@Model.Search" class="filter-pill @(Model.ActiveCategory == Category.Makeup ? "active" : "")">مكياج</a>
            <a asp-controller="Products" asp-action="Index" asp-route-category="Skincare" asp-route-search="@Model.Search" class="filter-pill @(Model.ActiveCategory == Category.Skincare ? "active" : "")">عناية بالبشرة</a>
        </div>
    </div>

    @if (Model.Products.Count == 0)
    {
        <p class="text-muted text-center" style="padding:5rem 1rem;font-size:1.05rem;font-weight:300;">لا توجد منتجات. جرّب بحثاً أو تصنيفاً آخر.</p>
    }
    else
    {
        <div class="product-grid">
            @foreach (var p in Model.Products)
            {
                <partial name="_ProductCard" model="p" />
            }
        </div>
    }
</div>
