@model Product
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div>
    <a asp-controller="Products" asp-action="Detail" asp-route-id="@Model.Id">
        <div class="luxury-card">
            <div class="card-img">
                <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
            </div>
        </div>
    </a>
    <div class="flex-between" style="margin-top:1rem;align-items:flex-start;">
        <div>
            <p class="text-muted" style="font-size:0.7rem;letter-spacing:0.08em;text-transform:uppercase;margin:0 0 0.25rem;">@CategoryLabels.Arabic(Model.Category)</p>
            <h3 style="font-size:1.125rem;margin:0;line-height:1.3;">@Model.Name</h3>
            <p class="text-muted" style="margin:0.25rem 0 0;">@Model.Price.ToString("N0") ج.م</p>
        </div>
        <form asp-controller="Cart" asp-action="Add" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-primary" style="padding:0.5rem 0.65rem;min-width:auto;" title="أضف للسلة">🛒</button>
        </form>
    </div>
</div>
