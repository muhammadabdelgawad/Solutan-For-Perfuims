@model Product
@{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}
<div class="product-card">
    <a asp-controller="Products" asp-action="Detail" asp-route-id="@Model.Id" class="product-card__link">
        <div class="luxury-card">
            <div class="card-img">
                <img src="@Model.ImageUrl" alt="@Model.Name" loading="lazy" />
            </div>
        </div>
    </a>
    <div class="product-card__meta">
        <div>
            <p class="eyebrow">@CategoryLabels.Arabic(Model.Category)</p>
            <h3>@Model.Name</h3>
            <p class="price">@Model.Price.ToString("N0") ج.م</p>
        </div>
        <form asp-controller="Cart" asp-action="Add" method="post" style="margin:0;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.Id" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <button type="submit" class="btn btn-icon-cart" title="أضف للسلة" aria-label="أضف للسلة">+</button>
        </form>
    </div>
</div>
